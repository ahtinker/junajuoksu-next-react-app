{
    "compilerOptions": {
        "target": "ES2020",
        "module": "commonjs",
        "lib": [
            "ES2020"
        ],
        "outDir": "./dist",
        "rootDir": ".",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true,
        "declaration": true,
        "declarationMap": true,
        "moduleResolution": "node"
    },
    "include": [
        "server.ts",
        "src/app/api/train-verification/websocket-server.ts"
    ],
    "exclude": [
        "node_modules"
    ]
}